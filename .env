# Animeitor API prefix used to print the contest/reveleitor URLs.
# This is set to `http://animeitor.naquadah.com.br` during the maratona.
# `http://localhost:8000` is fine for local testing:
PREFIX=http://localhost:8000

# URL of the animeitor server, used by printurls and the feeder.
# Internal API access must use HTTPS.
SERVER_URL=https://localhost:8443

# This is the public port. This is set to `80` during the SBC Maratona.
# `8000` is fine for local testing:
PUBLIC_PORT=8000

# Name of the internal credential entry. The token itself remains in secret_env.
INTERNAL_TOKEN_NAME=feeder

# Public media and scoring settings.
PHOTO_URL_FORMAT=https://icpc-latam-br-fp-2026.moj.naquadah.com.br/api/v1/contest/team-photo?contest=icpc-latam-br-fp-2026&user={team_login}
SOUND_URL_FORMAT=https://icpc-latam-br-fp-2026.moj.naquadah.com.br/api/v1/contest/team-music?contest=icpc-latam-br-fp-2026&user={team_login}
# SCORE_FREEZE_TIME_SECONDS=3600

# TLS file locations are public configuration; certificate contents and keys
# remain outside Git.
TLS_CERT=config/dev-certs/localhost-cert.pem
TLS_KEY=config/dev-certs/localhost-key.pem
TLS_PORT=8443
