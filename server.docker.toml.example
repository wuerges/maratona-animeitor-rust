# Docker development: mounted directly by the example Compose stack.
# Replace these development credentials before deployment.
revelation_salt = "development-server-salt-change-in-production"
public_port = 8000
tls_port = 8443
tls_cert = "config/dev-certs/localhost-cert.pem"
tls_key = "config/dev-certs/localhost-key.pem"
tls_ca_cert = "config/dev-certs/localhost-cert.pem"
server_url = "https://animeitor:8443"
public_url = "http://localhost:8000"
client_token = "feeder"

# Patterns are Rust regular expressions matched against the whole event name.
[[tokens]]
name = "feeder"
token = "development-token"
enabled = true
role = "read-write"
events = ["jones", "basic-example", "colombia", "regional-.*", "nacional-.*", "latam-.*"]

[[tokens]]
name = "observer"
token = "development-observer-token"
role = "read-only"
events = ["regional-.*"]

[[assets]]
directory = "/dist"
path = ""
[[assets]]
directory = "/dist"
path = "animeitor"
[[assets]]
directory = "/photos"
path = "photos"
[[assets]]
directory = "/sounds"
path = "sounds"

# Optional persistent storage (default: memory). See doc/databases.md.
# [database]
# type = "sqlite"
# path = "/data/animeitor.sqlite3"

# Optional process budgets; defaults admit 40,000 viewer sockets plus headroom.
# Admission ceilings are not a measured capacity guarantee.
# [limits]
# max_websockets = 50000
# max_connections = 60000
# max_public_requests = 128
# max_internal_requests = 32
# max_mutations = 32
# request_timeout_seconds = 15
