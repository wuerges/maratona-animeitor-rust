# Template processado pelo container na subida: __TARGET__ e __SCHEME__ vêm de
# SERVER_URL (padrão animeitor.naquadah.com.br). As métricas ficam no escopo
# interno (autenticado): /internal/metrics.

global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: animeitor
    metrics_path: /internal/metrics
    scheme: __SCHEME__
    basic_auth:
      username: usuario
      password_file: /prometheus/internal-token
    static_configs:
      - targets: ["__TARGET__"]
