# Example systemd service for the animeitor server.
#
# Install (as root):
#   cp config/regional_2026/animeitor-server.service /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now animeitor-server
#
# The release binary must be built first:
#   make -f config/regional_2026/Makefile rebuild-release-server
#
# Make sure no other process is already bound to the HTTP port (80)
# before starting the service.

[Unit]
Description=Maratona Animeitor server (animeitor-server)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ew
Group=ew
WorkingDirectory=/home/ew/maratona-animeitor-rust
Environment=RUST_LOG=info
# SENTRY_DSN and other secrets live in this gitignored file.
EnvironmentFile=-/home/ew/maratona-animeitor-rust/config/regional_2026/secret_env

# Each websocket connection holds a file descriptor for its lifetime.
# Without this, the server runs with systemd's default soft limit of 1024
# and runs out of file descriptors under load.
LimitNOFILE=65536

# Port 80 is privileged. Granting the capability here is more robust
# than `setcap` on the binary: a rebuild or copy replaces the file and
# strips file capabilities.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

ExecStart=/usr/bin/make -f config/regional_2026/Makefile run-standalone

# make and the animeitor-server child run in the same cgroup; the default
# KillMode=control-group stops both on restart/stop.
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
