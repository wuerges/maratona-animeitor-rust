# Copy to secret_env and replace the values for the 2026 event.
BOCA_URL=https://example.invalid/api/v1/contest/webcast?contest=replace-me&key=replace-me
INTERNAL_TOKEN_NAME=feeder-nacional-2026
INTERNAL_TOKEN=replace-with-a-long-random-token
INTERNAL_TOKENS_FILE=config/nacional_2026/internal_tokens.toml

# Optional: configure per-team media served by the contest API.
# PHOTO_URL_FORMAT=https://example.invalid/team-photo?user={team_login}
# SOUND_URL_FORMAT=https://example.invalid/team-music?user={team_login}

# Optional: override the webcast score-freeze time, in seconds.
# SCORE_FREEZE_TIME_SECONDS=14400
