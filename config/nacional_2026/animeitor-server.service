[Unit]
Description=Maratona Animeitor server (Nacional 2026)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ew
Group=ew
WorkingDirectory=/home/ew/maratona-animeitor-rust
Environment=RUST_LOG=info
LimitNOFILE=131072
# Set CPU/memory budgets in a systemd drop-in after measuring the real workload.
# See doc/capacity-testing.md; previous 2-core/2-GiB values were not validated.
TasksMax=256
# Axum serves production directly. Expose only the intended public HTTP/HTTPS
# ports; internal administration requires verified HTTPS. No proxy is required.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ExecStart=/home/ew/maratona-animeitor-rust/target/release/animeitor-server --server-config server.toml
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
