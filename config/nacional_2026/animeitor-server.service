[Unit]
Description=Maratona Animeitor server (Nacional 2026)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ew
Group=ew
WorkingDirectory=/home/ew/maratona-animeitor-rust
Environment=RUST_LOG=info
LimitNOFILE=65536
# Conservative host-protection budgets; size memory against the real event data.
MemoryHigh=1G
MemoryMax=2G
MemorySwapMax=0
CPUQuota=200%
TasksMax=256
# The binary binds all interfaces. Restrict both upstream ports in the host
# firewall to the local/private proxy; see doc/nginx-examples/README.md.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ExecStart=/home/ew/maratona-animeitor-rust/target/release/animeitor-server --server-config server.toml
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
